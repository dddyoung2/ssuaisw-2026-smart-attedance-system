# 이 파일을 .env 로 복사해서 사용:  copy .env.example .env
# .env 는 git 에 올리지 않음.

# DB 접속 주소
DB_URL=

# 데이터(DB 파일, 사진) 디렉터리
DATA_DIR=src/backend/data

# 프론트엔드 주소
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# 얼굴 엔진: dummy
FACE_ENGINE=dummy

# 코사인 유사도 임계값
THRESHOLD=0.5

USE_VERIFIED_FACES=false

# 업로드 최대 크기(MB)
MAX_UPLOAD_MB=5

LOG_LEVEL=INFO
