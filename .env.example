# 이 파일을 .env 로 복사해서 사용:  copy .env.example .env
# .env 는 git 에 올리지 않음.

# usaint DB 접속 주소 (비우면 DATA_DIR/usaint.db, SQLite)
DB_URL=

# 데이터 디렉터리 (데모용 usaint.db, 예시 증명사진, 데모 사진)
DATA_DIR=src/backend/data

# 프론트엔드 주소
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# 얼굴 엔진: retinaface (검출 RetinaFace, 가중치 필요) | dummy (가중치 없이 테스트용)
FACE_ENGINE=retinaface

# 코사인 유사도 임계값
THRESHOLD=0.5

# 업로드 최대 크기(MB). 카메라 원본 해상도 사진(최대 4K JPEG)이 들어옴
MAX_UPLOAD_MB=10

LOG_LEVEL=INFO
