# 이 파일을 .env 로 복사해서 사용하세요:  copy .env.example .env
# (.env 는 git 에 올리지 않습니다)

# (현재 미사용)
API_KEY=your_api_key_here

# DB 접속 주소. 비워두면 DATA_DIR/attendance.db (SQLite) 사용.
# PostgreSQL 예: postgresql+psycopg://user:password@localhost:5432/attendance
#   (psycopg[binary] 패키지 추가 설치 필요)
DB_URL=

# 데이터(DB 파일, 사진) 폴더. 상대경로는 저장소 루트 기준.
DATA_DIR=src/backend/data

# 프론트엔드 주소 (쉼표로 구분). VS Code Live Server 기본값.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# 얼굴 엔진: dummy | (모델 담당이 추가한 이름)
FACE_ENGINE=dummy

# 코사인 유사도가 이 값보다 커야 매칭 (실제 모델 확정 후 조정)
THRESHOLD=0.5

# true 면 이전 수업에서 교수가 확인(verified)한 얼굴도 비교 대상에 포함
USE_VERIFIED_FACES=false

# 업로드 최대 크기(MB)
MAX_UPLOAD_MB=5

LOG_LEVEL=INFO
